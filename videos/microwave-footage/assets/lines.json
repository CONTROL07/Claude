[
 {
  "line": 0,
  "text": "علاش فاش تنسخنو الماكلة فالميكرو أوند…",
  "start": 0.0,
  "end": 1.31,
  "segs": [
   [
    0.0,
    1.31
   ]
  ]
 },
 {
  "line": 1,
  "text": "تتسخن الماكلة وكاع ما تيسخن الطبسيل؟",
  "start": 1.31,
  "end": 3.07,
  "segs": [
   [
    1.31,
    2.73
   ],
   [
    2.85,
    3.07
   ]
  ]
 },
 {
  "line": 2,
  "text": "غادي تفهم معايا كلشي فدقيقة!",
  "start": 3.19,
  "end": 4.39,
  "segs": [
   [
    3.19,
    4.39
   ]
  ]
 },
 {
  "line": 3,
  "text": "وسط الميكرو أوند تتكون واحد البياسة…",
  "start": 4.51,
  "end": 5.764,
  "segs": [
   [
    4.51,
    5.764
   ]
  ]
 },
 {
  "line": 4,
  "text": "اللي سميتها الماغنيطرون.",
  "start": 5.764,
  "end": 7.2,
  "segs": [
   [
    5.764,
    6.41
   ],
   [
    6.53,
    7.2
   ]
  ]
 },
 {
  "line": 5,
  "text": "هاد الماغنيطرون تيطلق واحد الموجات اللي هوما…",
  "start": 7.32,
  "end": 9.53,
  "segs": [
   [
    7.32,
    9.53
   ]
  ]
 },
 {
  "line": 6,
  "text": "من نفس العائلة تقريبا ديال الويفي…",
  "start": 9.65,
  "end": 11.13,
  "segs": [
   [
    9.65,
    11.13
   ]
  ]
 },
 {
  "line": 7,
  "text": "ولكن دابا بالرجولة، قبل ما تكمل الفيديو…",
  "start": 11.13,
  "end": 12.94,
  "segs": [
   [
    11.13,
    12.94
   ]
  ]
 },
 {
  "line": 8,
  "text": "دير معايا واحد اللايك، واحد الابوني!",
  "start": 13.06,
  "end": 14.67,
  "segs": [
   [
    13.06,
    13.96
   ],
   [
    14.08,
    14.67
   ]
  ]
 },
 {
  "line": 9,
  "text": "وهاد ليزوند هادو تيبقاو تيضربو…",
  "start": 14.79,
  "end": 16.056,
  "segs": [
   [
    14.79,
    16.056
   ]
  ]
 },
 {
  "line": 10,
  "text": "فدوك الحيوط ديال الميكرو أوند ديال الحديد…",
  "start": 16.056,
  "end": 18.425,
  "segs": [
   [
    16.056,
    16.9
   ],
   [
    17.02,
    18.425
   ]
  ]
 },
 {
  "line": 11,
  "text": "حتى كيلقاو الماكلة اللي…",
  "start": 18.425,
  "end": 19.83,
  "segs": [
   [
    18.425,
    19.83
   ]
  ]
 },
 {
  "line": 12,
  "text": "وطبيعة الحال هاد الماكلة هادي…",
  "start": 19.95,
  "end": 21.45,
  "segs": [
   [
    19.95,
    21.45
   ]
  ]
 },
 {
  "line": 13,
  "text": "تتكون وسطها الما.",
  "start": 21.57,
  "end": 22.28,
  "segs": [
   [
    21.57,
    22.28
   ]
  ]
 },
 {
  "line": 14,
  "text": "ولكن بلاتي…",
  "start": 22.4,
  "end": 23.09,
  "segs": [
   [
    22.4,
    23.09
   ]
  ]
 },
 {
  "line": 15,
  "text": "شنو الدور ديال الما هنا؟",
  "start": 23.21,
  "end": 24.29,
  "segs": [
   [
    23.21,
    24.29
   ]
  ]
 },
 {
  "line": 16,
  "text": "كيفما كنعرفو كاملين…",
  "start": 24.29,
  "end": 25.37,
  "segs": [
   [
    24.29,
    25.37
   ]
  ]
 },
 {
  "line": 17,
  "text": "الما عندو جوج ديال الأطراف…",
  "start": 25.49,
  "end": 26.33,
  "segs": [
   [
    25.49,
    26.33
   ]
  ]
 },
 {
  "line": 18,
  "text": "واحد سالب، واحد موجب.",
  "start": 26.45,
  "end": 27.8,
  "segs": [
   [
    26.45,
    27.03
   ],
   [
    27.15,
    27.8
   ]
  ]
 },
 {
  "line": 19,
  "text": "وداك الموجة كتبقى تشد الما وتديه من ليمن…",
  "start": 27.92,
  "end": 30.43,
  "segs": [
   [
    27.92,
    28.58
   ],
   [
    28.7,
    29.52
   ],
   [
    29.64,
    30.43
   ]
  ]
 },
 {
  "line": 20,
  "text": "لليسر… كتر من جوج ونص المليار مرة فالثانية!",
  "start": 30.55,
  "end": 32.66,
  "segs": [
   [
    30.55,
    30.98
   ],
   [
    31.1,
    32.66
   ]
  ]
 },
 {
  "line": 21,
  "text": "وداك الجزيئات تيبقاو يدورو وتيتحكو فبعضياتهم…",
  "start": 32.78,
  "end": 35.62,
  "segs": [
   [
    32.78,
    33.0
   ],
   [
    33.12,
    35.62
   ]
  ]
 },
 {
  "line": 22,
  "text": "كيفما نتا كدير باش تسخن…",
  "start": 35.74,
  "end": 37.392,
  "segs": [
   [
    35.74,
    36.42
   ],
   [
    36.54,
    37.392
   ]
  ]
 },
 {
  "line": 23,
  "text": "وداك الحكان بالضبط هو اللي كيولي سخونية.",
  "start": 37.392,
  "end": 39.38,
  "segs": [
   [
    37.392,
    39.38
   ]
  ]
 },
 {
  "line": 24,
  "text": "ولكن بلاتي…",
  "start": 39.5,
  "end": 40.127,
  "segs": [
   [
    39.5,
    40.127
   ]
  ]
 },
 {
  "line": 25,
  "text": "علاش الطبسيل ما كتابليكاش عليه هاد القضية؟",
  "start": 40.127,
  "end": 42.06,
  "segs": [
   [
    40.127,
    41.59
   ],
   [
    41.71,
    42.06
   ]
  ]
 },
 {
  "line": 26,
  "text": "كيفما كنعرفو كاملين…",
  "start": 42.18,
  "end": 43.235,
  "segs": [
   [
    42.18,
    43.235
   ]
  ]
 },
 {
  "line": 27,
  "text": "الطبسيل تيكون سوا من السيراميك ولا من الزاج…",
  "start": 43.235,
  "end": 45.345,
  "segs": [
   [
    43.235,
    45.345
   ]
  ]
 },
 {
  "line": 28,
  "text": "والزاج ولا السيراميك…",
  "start": 45.345,
  "end": 46.4,
  "segs": [
   [
    45.345,
    46.4
   ]
  ]
 },
 {
  "line": 29,
  "text": "فيهم واحد الجزيئات اللي هوما صلبين…",
  "start": 46.52,
  "end": 47.972,
  "segs": [
   [
    46.52,
    47.972
   ]
  ]
 },
 {
  "line": 30,
  "text": "يعني ما فيهش الما الحر…",
  "start": 47.972,
  "end": 49.16,
  "segs": [
   [
    47.972,
    49.16
   ]
  ]
 },
 {
  "line": 31,
  "text": "كيفاش غادي يتحرك؟ لا، راه ماشي سخون…",
  "start": 49.28,
  "end": 51.2,
  "segs": [
   [
    49.28,
    51.2
   ]
  ]
 },
 {
  "line": 32,
  "text": "كيما تيدير الضو مع السرجم ديال داركم.",
  "start": 51.32,
  "end": 53.23,
  "segs": [
   [
    51.32,
    52.08
   ],
   [
    52.2,
    53.23
   ]
  ]
 },
 {
  "line": 33,
  "text": "وبهاد الطريقة هادي تيكون سخن غير الماكلة…",
  "start": 53.35,
  "end": 55.73,
  "segs": [
   [
    53.35,
    55.73
   ]
  ]
 },
 {
  "line": 34,
  "text": "وما تيسخنش الطبسيل.",
  "start": 55.85,
  "end": 56.46,
  "segs": [
   [
    55.85,
    56.46
   ]
  ]
 },
 {
  "line": 35,
  "text": "دونك الميكرو أوند ما تيسخنش الطبسيل…",
  "start": 56.58,
  "end": 58.12,
  "segs": [
   [
    56.58,
    58.12
   ]
  ]
 },
 {
  "line": 36,
  "text": "حيتاش هو أصلا تيسخن غير…",
  "start": 58.12,
  "end": 59.66,
  "segs": [
   [
    58.12,
    59.66
   ]
  ]
 },
 {
  "line": 37,
  "text": "الما اللي كاين وسط…",
  "start": 59.78,
  "end": 60.44,
  "segs": [
   [
    59.78,
    60.44
   ]
  ]
 }
]