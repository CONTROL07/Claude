[
 {
  "line": 0,
  "text": "علاش فاش كنسخنو الماكلة فالميكرو أوند… ما كيسخنش الطبسيل؟",
  "start": 0.0,
  "end": 2.73,
  "segs": [
   [
    0.0,
    2.73
   ]
  ]
 },
 {
  "line": 1,
  "text": "غادي نفهمك كلشي فدقيقة!",
  "start": 2.85,
  "end": 4.39,
  "segs": [
   [
    2.85,
    3.07
   ],
   [
    3.19,
    4.39
   ]
  ]
 },
 {
  "line": 2,
  "text": "وسط الميكرو أوند كاينة واحد البياسة…",
  "start": 4.51,
  "end": 6.41,
  "segs": [
   [
    4.51,
    6.41
   ]
  ]
 },
 {
  "line": 3,
  "text": "سميتها الماغنيترون.",
  "start": 6.53,
  "end": 7.2,
  "segs": [
   [
    6.53,
    7.2
   ]
  ]
 },
 {
  "line": 4,
  "text": "هاد الماغنيترون كيصيفط واحد الموجات…",
  "start": 7.32,
  "end": 9.53,
  "segs": [
   [
    7.32,
    9.53
   ]
  ]
 },
 {
  "line": 5,
  "text": "من نفس العائلة تقريبا ديال الويفي… ولكن قبل ما نكمل…",
  "start": 9.65,
  "end": 12.94,
  "segs": [
   [
    9.65,
    12.94
   ]
  ]
 },
 {
  "line": 6,
  "text": "دير واحد لايك!",
  "start": 13.06,
  "end": 14.67,
  "segs": [
   [
    13.06,
    13.96
   ],
   [
    14.08,
    14.67
   ]
  ]
 },
 {
  "line": 7,
  "text": "وهاد الموجات كيبقاو يضربو…",
  "start": 14.79,
  "end": 16.9,
  "segs": [
   [
    14.79,
    16.9
   ]
  ]
 },
 {
  "line": 8,
  "text": "فالحيوط ديال الحديد ديال الميكرو أوند حتى كيلقاو الماكلة.",
  "start": 17.02,
  "end": 19.83,
  "segs": [
   [
    17.02,
    19.83
   ]
  ]
 },
 {
  "line": 9,
  "text": "وطبعا داك الماكلة عامرة بالما.",
  "start": 19.95,
  "end": 22.28,
  "segs": [
   [
    19.95,
    21.45
   ],
   [
    21.57,
    22.28
   ]
  ]
 },
 {
  "line": 10,
  "text": "ولكن بلاتي…",
  "start": 22.4,
  "end": 23.09,
  "segs": [
   [
    22.4,
    23.09
   ]
  ]
 },
 {
  "line": 11,
  "text": "شنو الدور ديال الما؟ كيفما كنعرفو كاملين…",
  "start": 23.21,
  "end": 25.37,
  "segs": [
   [
    23.21,
    25.37
   ]
  ]
 },
 {
  "line": 12,
  "text": "الما عندو جوج أطراف…",
  "start": 25.49,
  "end": 26.33,
  "segs": [
   [
    25.49,
    26.33
   ]
  ]
 },
 {
  "line": 13,
  "text": "واحد سالب وواحد موجب.",
  "start": 26.45,
  "end": 27.8,
  "segs": [
   [
    26.45,
    27.03
   ],
   [
    27.15,
    27.8
   ]
  ]
 },
 {
  "line": 14,
  "text": "وداك الموجة كتبقى تجرّو من ليمن…",
  "start": 27.92,
  "end": 30.43,
  "segs": [
   [
    27.92,
    28.58
   ],
   [
    28.7,
    29.52
   ],
   [
    29.64,
    30.43
   ]
  ]
 },
 {
  "line": 15,
  "text": "لليسر… تقريبا جوج مليار ونص فالثانية!",
  "start": 30.55,
  "end": 32.66,
  "segs": [
   [
    30.55,
    30.98
   ],
   [
    31.1,
    32.66
   ]
  ]
 },
 {
  "line": 16,
  "text": "وهادوك الجزيئات كيبقاو يدورو ويتحكو فبعضياتهم…",
  "start": 32.78,
  "end": 35.62,
  "segs": [
   [
    32.78,
    33.0
   ],
   [
    33.12,
    35.62
   ]
  ]
 },
 {
  "line": 17,
  "text": "كيما كتحك يديك فاش كيجيك البرد.",
  "start": 35.74,
  "end": 36.42,
  "segs": [
   [
    35.74,
    36.42
   ]
  ]
 },
 {
  "line": 18,
  "text": "وداك الحكان بالضبط هو اللي كيولد السخونية.",
  "start": 36.54,
  "end": 39.38,
  "segs": [
   [
    36.54,
    39.38
   ]
  ]
 },
 {
  "line": 19,
  "text": "ولكن بلاتي… الطبسيل علاش ما كتطبقش عليه هاد القضية؟",
  "start": 39.5,
  "end": 42.06,
  "segs": [
   [
    39.5,
    41.59
   ],
   [
    41.71,
    42.06
   ]
  ]
 },
 {
  "line": 20,
  "text": "كيفما كنعرفو كاملين، الطبسيل كيكون يا من السيراميك ولا من الزاج…",
  "start": 42.18,
  "end": 46.4,
  "segs": [
   [
    42.18,
    46.4
   ]
  ]
 },
 {
  "line": 21,
  "text": "الجزيئات ديالو صلبين، ما فيهش الما الحر…",
  "start": 46.52,
  "end": 49.16,
  "segs": [
   [
    46.52,
    49.16
   ]
  ]
 },
 {
  "line": 22,
  "text": "اللي غادي يتحرك ويسخن.",
  "start": 49.28,
  "end": 51.2,
  "segs": [
   [
    49.28,
    51.2
   ]
  ]
 },
 {
  "line": 23,
  "text": "كيما كيدير الضو مع السرجم.",
  "start": 51.32,
  "end": 53.23,
  "segs": [
   [
    51.32,
    52.08
   ],
   [
    52.2,
    53.23
   ]
  ]
 },
 {
  "line": 24,
  "text": "وبهاد الطريقة كتسخن غير الماكلة…",
  "start": 53.35,
  "end": 55.73,
  "segs": [
   [
    53.35,
    55.73
   ]
  ]
 },
 {
  "line": 25,
  "text": "يعني الميكرو أوند ما كيسخنش الطبسيل…",
  "start": 55.85,
  "end": 59.66,
  "segs": [
   [
    55.85,
    56.46
   ],
   [
    56.58,
    59.66
   ]
  ]
 },
 {
  "line": 26,
  "text": "لأنو أصلاً…",
  "start": 59.78,
  "end": 60.44,
  "segs": [
   [
    59.78,
    60.44
   ]
  ]
 }
]