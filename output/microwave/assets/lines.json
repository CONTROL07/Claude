[
 {
  "line": 0,
  "text": "علاش فاش تانسخنو الماكلة فالمايكروويف…",
  "start": 0.0,
  "end": 2.03,
  "segs": [
   {
    "start": 0.0,
    "end": 2.03
   }
  ]
 },
 {
  "line": 1,
  "text": "ماتايسخنش الطبسيل؟",
  "start": 2.15,
  "end": 3.19,
  "segs": [
   {
    "start": 2.15,
    "end": 3.19
   }
  ]
 },
 {
  "line": 2,
  "text": "غادي نفهمك فدقيقة.",
  "start": 3.31,
  "end": 4.37,
  "segs": [
   {
    "start": 3.31,
    "end": 4.37
   }
  ]
 },
 {
  "line": 3,
  "text": "داخل المايكروويف كاينة واحد القطعة سميتها الماڭْنِيترون.",
  "start": 4.49,
  "end": 7.91,
  "segs": [
   {
    "start": 4.49,
    "end": 6.92
   },
   {
    "start": 7.04,
    "end": 7.91
   }
  ]
 },
 {
  "line": 4,
  "text": "تاتخرّج موجات… من نفس العائلة ديال الويفي.",
  "start": 8.03,
  "end": 10.29,
  "segs": [
   {
    "start": 8.03,
    "end": 8.96
   },
   {
    "start": 9.08,
    "end": 10.29
   }
  ]
 },
 {
  "line": 5,
  "text": "الموجات تاتضرب فالحيوط ديال الحديد… وترجع.",
  "start": 10.41,
  "end": 12.69,
  "segs": [
   {
    "start": 10.41,
    "end": 12.16
   },
   {
    "start": 12.28,
    "end": 12.69
   }
  ]
 },
 {
  "line": 6,
  "text": "وتبقى غادية جاية داخل الصندوق…",
  "start": 12.81,
  "end": 14.8,
  "segs": [
   {
    "start": 12.81,
    "end": 14.8
   }
  ]
 },
 {
  "line": 7,
  "text": "حتى تلقى الماكلة.",
  "start": 14.92,
  "end": 15.81,
  "segs": [
   {
    "start": 14.92,
    "end": 15.81
   }
  ]
 },
 {
  "line": 8,
  "text": "والماكلة… عامرة بالما.",
  "start": 15.93,
  "end": 17.21,
  "segs": [
   {
    "start": 15.93,
    "end": 16.43
   },
   {
    "start": 16.55,
    "end": 17.21
   }
  ]
 },
 {
  "line": 9,
  "text": "وشنو تايدير الما؟",
  "start": 17.33,
  "end": 18.08,
  "segs": [
   {
    "start": 17.33,
    "end": 18.08
   }
  ]
 },
 {
  "line": 10,
  "text": "الجزيء ديال الما عندو جوج طراف…",
  "start": 18.2,
  "end": 20.01,
  "segs": [
   {
    "start": 18.2,
    "end": 19.1
   },
   {
    "start": 19.22,
    "end": 20.01
   }
  ]
 },
 {
  "line": 11,
  "text": "طرف موجب… وطرف سالب.",
  "start": 20.13,
  "end": 21.59,
  "segs": [
   {
    "start": 20.13,
    "end": 20.77
   },
   {
    "start": 20.89,
    "end": 21.59
   }
  ]
 },
 {
  "line": 12,
  "text": "والموجة تاتجرّو… ليمن وليسر.",
  "start": 21.71,
  "end": 24.11,
  "segs": [
   {
    "start": 21.71,
    "end": 22.39
   },
   {
    "start": 22.51,
    "end": 23.06
   },
   {
    "start": 23.18,
    "end": 23.59
   },
   {
    "start": 23.71,
    "end": 24.11
   }
  ]
 },
 {
  "line": 13,
  "text": "تقريبا جوج مليار ونص ديال المرات فالثانية!",
  "start": 24.23,
  "end": 26.77,
  "segs": [
   {
    "start": 24.23,
    "end": 26.77
   }
  ]
 },
 {
  "line": 14,
  "text": "الجزيئات تاتدور… وتاتضرب فبعضياتها.",
  "start": 27.08,
  "end": 29.2,
  "segs": [
   {
    "start": 27.08,
    "end": 28.06
   },
   {
    "start": 28.18,
    "end": 29.2
   }
  ]
 },
 {
  "line": 15,
  "text": "بحال ملي تاتحكّ يديك فالبرد…",
  "start": 29.32,
  "end": 30.72,
  "segs": [
   {
    "start": 29.32,
    "end": 30.72
   }
  ]
 },
 {
  "line": 16,
  "text": "هاد الحكّان… هو السخانة.",
  "start": 30.84,
  "end": 32.16,
  "segs": [
   {
    "start": 30.84,
    "end": 31.47
   },
   {
    "start": 31.59,
    "end": 32.16
   }
  ]
 },
 {
  "line": 17,
  "text": "والطبسيل؟ علاش ماتايسخنش؟",
  "start": 32.28,
  "end": 33.86,
  "segs": [
   {
    "start": 32.28,
    "end": 32.92
   },
   {
    "start": 33.04,
    "end": 33.86
   }
  ]
 },
 {
  "line": 18,
  "text": "الطبسيل ديال السيراميك… ولا ديال الزاج.",
  "start": 33.98,
  "end": 35.81,
  "segs": [
   {
    "start": 33.98,
    "end": 35.81
   }
  ]
 },
 {
  "line": 19,
  "text": "الجزيئات ديالو مربوطين مع بعضياتهم… وقاصحين.",
  "start": 35.93,
  "end": 38.4,
  "segs": [
   {
    "start": 35.93,
    "end": 38.4
   }
  ]
 },
 {
  "line": 20,
  "text": "ما فيهش الما الحر اللي يدور.",
  "start": 38.52,
  "end": 40.0,
  "segs": [
   {
    "start": 38.52,
    "end": 40.0
   }
  ]
 },
 {
  "line": 21,
  "text": "داكشي علاش الموجة تاتدوز من وسطو…",
  "start": 40.12,
  "end": 41.83,
  "segs": [
   {
    "start": 40.12,
    "end": 41.83
   }
  ]
 },
 {
  "line": 22,
  "text": "بحال الضو ملي تايدوز من الشرجم.",
  "start": 41.95,
  "end": 43.32,
  "segs": [
   {
    "start": 41.95,
    "end": 43.32
   }
  ]
 },
 {
  "line": 23,
  "text": "وتايسخن غير… من الماكلة اللي فوقو.",
  "start": 43.44,
  "end": 45.13,
  "segs": [
   {
    "start": 43.44,
    "end": 45.13
   }
  ]
 },
 {
  "line": 24,
  "text": "والغريب؟",
  "start": 45.25,
  "end": 45.82,
  "segs": [
   {
    "start": 45.25,
    "end": 45.82
   }
  ]
 },
 {
  "line": 25,
  "text": "الثلج… راه حتى هو ما.",
  "start": 45.94,
  "end": 47.04,
  "segs": [
   {
    "start": 45.94,
    "end": 47.04
   }
  ]
 },
 {
  "line": 26,
  "text": "ولكن الجزيئات ديالو مجمّدين… مايقدروش يدورو.",
  "start": 47.16,
  "end": 49.77,
  "segs": [
   {
    "start": 47.16,
    "end": 48.78
   },
   {
    "start": 48.9,
    "end": 49.77
   }
  ]
 },
 {
  "line": 27,
  "text": "داكشي علاش تايدوب بشوية… فالمايكروويف.",
  "start": 49.89,
  "end": 52.0,
  "segs": [
   {
    "start": 49.89,
    "end": 51.8
   },
   {
    "start": 51.92,
    "end": 52.0
   }
  ]
 },
 {
  "line": 28,
  "text": "يعني المايكروويف ماتايسخنش الطبسيل…",
  "start": 52.12,
  "end": 53.92,
  "segs": [
   {
    "start": 52.12,
    "end": 53.92
   }
  ]
 },
 {
  "line": 29,
  "text": "هو تايحرّك الما… اللي فالماكلة.",
  "start": 54.04,
  "end": 55.79,
  "segs": [
   {
    "start": 54.04,
    "end": 55.0
   },
   {
    "start": 55.12,
    "end": 55.79
   }
  ]
 },
 {
  "line": 30,
  "text": "قولو لينا فالكومونتير…",
  "start": 55.91,
  "end": 56.97,
  "segs": [
   {
    "start": 55.91,
    "end": 56.97
   }
  ]
 },
 {
  "line": 31,
  "text": "شنو بغيتو نشرحو المرة الجاية؟",
  "start": 57.09,
  "end": 58.28,
  "segs": [
   {
    "start": 57.09,
    "end": 58.28
   }
  ]
 }
]